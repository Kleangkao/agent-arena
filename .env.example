GEMINI_API_KEY=
GEMINI_MODEL=
# Hosted backend only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ARENA_PUBLIC_ORIGIN=
# Private previews only.
GEMINI_V2_API_KEY=
ARENA_V25_VALIDATION_TOKEN=
ARENA_V26_VALIDATION_TOKEN=
# Development only. Hosted previews require the separate flag and normal hosted protections.
ARENA_LOCAL_SQUADS=0
ARENA_PREVIEW_SQUADS=0
# Production hosted opt-in. Requires server-only credentials and the canonical HTTPS origin.
ARENA_PUBLIC_SQUADS=0
# Server-only spacing between live match starts in one database. Default 60 seconds when unset, or 1–3600 based on provider capacity.
ARENA_LIVE_MIN_START_INTERVAL_SECONDS=
# Optional 64-character lowercase hexadecimal token for loopback-only squad experiments.
ARENA_LOCAL_SQUAD_TEST_TOKEN=
PORT=3001
BSC_TESTNET_RPC=
BSC_TESTNET_OPERATOR_KEY=
BSC_TESTNET_PLAYER_KEY=
# Public deployment identifiers only. Populate after a confirmed settlement.
VITE_BSC_TESTNET_CONTRACT=
VITE_BSC_TESTNET_SETTLEMENT_TX=
# Optional public BSC Testnet address of SquadReplayRegistry.
VITE_BSC_TESTNET_SQUAD_REGISTRY=
